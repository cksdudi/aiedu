rules_version = '2';

// ============================================================
//  교육 수료관리 시스템 - Firestore 보안 규칙
//  Firebase 콘솔 > Firestore Database > 규칙 에 붙여넣고 [게시] 하세요.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 명단 · 교육자료 · 수료기록 · 설정
    // 기관 내부망 배포를 전제로 한 기본 설정입니다.
    match /{col}/{docId} {
      allow read, write: if col in ['members', 'materials', 'completions', 'settings'];
    }

    // ------------------------------------------------------------------
    // [권장] 외부 인터넷에 공개한다면 위 블록을 지우고 아래를 사용하세요.
    // Firebase Authentication(익명 로그인 이상)을 켠 뒤 적용합니다.
    //
    // match /{col}/{docId} {
    //   allow read: if request.auth != null;
    //   allow create, update: if request.auth != null
    //                         && col in ['completions'];
    //   allow write: if request.auth != null
    //                && request.auth.token.admin == true;   // 관리자 커스텀 클레임
    // }
    // ------------------------------------------------------------------
  }
}
